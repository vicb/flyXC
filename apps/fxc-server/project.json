{
  "name": "fxc-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fxc-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "./dist"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/fxc-server/dist/index.js"
      },
      "configurations": {
        "production": {
          "command": "node apps/fxc-server/dist/index.js"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/fxc-server/dist/package.json",
        "{workspaceRoot}/apps/fxc-server/dist/pnpm-lock.yaml",
        "{workspaceRoot}/apps/fxc-server/dist/pnpm-workspace.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/fxc-server/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["prune"],
      "options": {
        "command": "gcloud app deploy apps/fxc-server/dist/app.yaml"
      }
    }
  }
}
