{
  "name": "fxc-front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/fxc-front/src",
  "tags": [],
  "targets": {
    "build-wasm": {
      "command": "PATH=\"$HOME/.cargo/bin:$PATH\"; if command -v wasm-pack >/dev/null 2>&1; then wasm-pack build apps/fxc-front/rustigc/rustigc-wasm --target web; elif [ -f apps/fxc-front/rustigc/rustigc-wasm/pkg/rustigc_wasm_bg.wasm ]; then echo \"Using prebuilt rustigc-wasm package\"; else echo \"wasm-pack not found and no prebuilt wasm package available\" && exit 1; fi",
      "outputs": ["{projectRoot}/rustigc/rustigc-wasm/pkg"]
    },
    "build": {
      "dependsOn": ["optimizer", "build-wasm"],
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/apps/fxc-front/dist"],
      "defaultConfiguration": "production",
      "options": {
        "target": "es2020",
        "outDir": "./dist"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "dependsOn": ["build-wasm"],
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "dependsOn": ["build-wasm"],
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  }
}
