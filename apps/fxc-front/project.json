{
  "name": "fxc-front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/fxc-front/src",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": ["optimizer"],
      "outputs": ["{projectRoot}/{options.outDir}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "es2022",
        "outDir": "./dist"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "visualizer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VISUALIZER=1 pnpm nx build fxc-front --skip-nx-cache"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "wrangler deploy",
        "cwd": "{projectRoot}"
      }
    }
  }
}
