{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flyxc-workers",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
