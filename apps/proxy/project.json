{
  "name": "proxy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/proxy/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "./dist"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/proxy/dist/index.js"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        },
        "production": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/proxy/dist/package.json",
        "{workspaceRoot}/apps/proxy/dist/pnpm-lock.yaml",
        "{workspaceRoot}/apps/proxy/dist/pnpm-workspace.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/proxy/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["prune"],
      "options": {
        "file": "apps/proxy/Dockerfile",
        "platforms": ["linux/amd64", "linux/arm64"],
        "engine": "docker",
        "push": true,
        "pull": true,
        "tags": ["us-docker.pkg.dev/fly-xc/docker/proxy"]
      }
    },
    "create-template": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gcloud compute instance-templates delete proxy-tmpl --quiet || true && gcloud compute instance-templates create proxy-tmpl --machine-type=f1-micro --image-family=cos-stable --image-project=cos-cloud --boot-disk-size=10GB --boot-disk-type=pd-balanced --tags=http-server --scopes=cloud-platform --metadata=google-logging-enabled=true,google-logging-use-fluentbit=true --metadata-from-file=user-data=apps/proxy/cloud-config.yaml"
      }
    }
  }
}
